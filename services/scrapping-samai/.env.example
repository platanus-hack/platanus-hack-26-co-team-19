# =====================================================================
# PostgreSQL - DigitalOcean Managed DB (Bogotá)
# Copy to .env and fill in values. Do not commit .env.
# =====================================================================

# --- Conexión principal (host público) -------------------------------
DATABASE_URL=postgresql://USER:PASSWORD@HOST:25060/defaultdb?sslmode=require

# --- Conexión por VPC (solo desde droplets en la misma red) ----------
DATABASE_URL_PRIVATE=postgresql://USER:PASSWORD@PRIVATE_HOST:25060/defaultdb?sslmode=require

# --- Variables sueltas (libpq / psql las toma automáticamente) -------
PGHOST=
PGHOST_PRIVATE=
PGPORT=25060
PGUSER=
PGPASSWORD=
PGDATABASE=defaultdb
PGSSLMODE=require

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

S3_BUCKET=
AWS_REGION=us-east-1
S3_PREFIX=pdfs/

# --- App -------------------------------------------------------------
DB_SCHEMA=corte
CSV_DIR=./data
