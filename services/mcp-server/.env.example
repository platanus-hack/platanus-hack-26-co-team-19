# Puerto HTTP del MCP (Streamable HTTP en /mcp)
MCP_PORT=3333

# Directorio de los CSV (perfiles.csv, providencias.csv, votos.csv)
# Solo se usa si DATA_BACKEND=csv
DATA_DIR=.

# csv | postgres
DATA_BACKEND=postgres

# Obligatorio si DATA_BACKEND=postgres (mismo Postgres que web-ui)
DATABASE_URL=postgresql://user:pass@host:5432/db?sslmode=require
