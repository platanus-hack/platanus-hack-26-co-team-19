# DigitalOcean Managed Postgres (private VPC hostname). Use sslmode=require.
# Example: postgresql://USER:PASSWORD@private-....db.ondigitalocean.com:25060/defaultdb?sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/defaultdb?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@localhost:5432/defaultdb?sslmode=require"

BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

RESEND_API_KEY=""
RESEND_FROM_EMAIL=""

NEXT_PUBLIC_APP_URL="http://localhost:3000"

MINIO_PORT="9000"
MINIO_CONSOLE_PORT="9001"
MINIO_ROOT_USER="admin"
MINIO_ROOT_PASSWORD="admin"
MINIO_SERVER_URL="localhost"
MINIO_USE_SSL="false"
MINIO_BROWSER_REDIRECT_URL="localhost"
MINIO_REGION="us-east-1"
MINIO_BUCKET_NAME="public-assets"

# AWS S3 (PDFs de providencias). No commitear secretos reales.
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-1"
AWS_S3_BUCKET=""

