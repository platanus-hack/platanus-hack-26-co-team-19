model Contact {
  id        String        @id @default(uuid())
  name      String
  email     String
  subject   String?
  message   String
  status    ContactStatus @default(NEW)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @default(now()) @updatedAt

  @@index([email])
  @@index([status])
  @@index([createdAt])
  @@map("contact_submission")
  @@schema("public")
}

enum ContactStatus {
  NEW
  READ
  ARCHIVED

  @@schema("public")
}
