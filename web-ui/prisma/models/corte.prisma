/// Scraping / MCP. DDL is owned by Postgres, not by Prisma migrations.
/// Most corte tables have no PK/UNIQUE; Prisma Client cannot query @@ignore models.
/// View `corte.perfiles` is not modeled: Prisma would emit CREATE TABLE and conflict with the view.

/// The underlying table does not contain a valid unique identifier.
model Descriptor {
  id          String?
  certificado String?
  radicado    String?
  descriptor  String?

  @@ignore
  @@map("descriptores")
  @@schema("corte")
}

